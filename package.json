{
  "name": "hackutd-family-response",
  "version": "0.1.0",
  "private": true,
  "description": "Fictional disaster-response family inquiry demo; offline-first, zero API spend.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "test:training": "PYTHONPATH=training .venv/bin/python -m unittest discover -s training/tests -v",
    "test:model-import": ".venv/bin/python -m unittest discover -s test -p test_model_import.py -v",
    "test:geography": ".venv/bin/python -m unittest discover -s test -p test_houston_geometry.py -v",
    "import:model": ".venv/bin/python scripts/import_model.py"
  }
}
